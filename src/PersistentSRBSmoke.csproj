<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B91D0691-8E78-4A12-8D9B-D0B0B005B2A2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>PersistentSRBSmoke</RootNamespace>
    <AssemblyName>PersistentSRBSmoke</AssemblyName>
    <TargetFrameworkVersion>v4.7</TargetFrameworkVersion>
    <LangVersion>7.2</LangVersion>
    <FileAlignment>512</FileAlignment>
    <KSPManagedDir Condition=" '$(KSP_DIR)' != '' ">$(KSP_DIR)\KSP_x64_Data\Managed</KSPManagedDir>
    <!-- CI builds do not redistribute KSP DLLs. They compile against public skeleton references. -->
    <UseKspSkeletons Condition=" '$(UseKspSkeletons)' == '' And '$(KSP_DIR)' == '' ">true</UseKspSkeletons>
    <UseKspSkeletons Condition=" '$(UseKspSkeletons)' == '' ">false</UseKspSkeletons>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <!-- Makes command-line/CI builds reproducible when the machine lacks the legacy v4.7 dev pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net47" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition=" '$(UseKspSkeletons)' != 'true' ">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSPManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition=" '$(UseKspSkeletons)' == 'true' ">
    <PackageReference Include="Defiant_Zombie.KSP.Skeleton.Assembly-CSharp" Version="1.11.2" />
    <PackageReference Include="Defiant_Zombie.KSP.Skeleton.UnityEngine" Version="1.11.2" />
    <PackageReference Include="Defiant_Zombie.KSP.Skeleton.UnityEngine.CoreModule" Version="1.11.2" />
    <PackageReference Include="Defiant_Zombie.KSP.Skeleton.UnityEngine.ParticleSystemModule" Version="1.11.2" />
  </ItemGroup>

  <!-- Legacy non-SDK projects do not automatically turn PackageReference compile assets into
       references. Keep explicit hints so the public skeleton mode really compiles in CI. -->
  <ItemGroup Condition=" '$(UseKspSkeletons)' == 'true' ">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(NuGetPackageRoot)defiant_zombie.ksp.skeleton.assembly-csharp\1.11.2\lib\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NuGetPackageRoot)defiant_zombie.ksp.skeleton.unityengine.coremodule\1.11.2\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(NuGetPackageRoot)defiant_zombie.ksp.skeleton.unityengine\1.11.2\lib\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(NuGetPackageRoot)defiant_zombie.ksp.skeleton.unityengine.particlesystemmodule\1.11.2\lib\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PersistentSRBSmoke\PersistentSRBSmokeController.cs" />
    <Compile Include="PersistentSRBSmoke\Settings.cs" />
    <Compile Include="PersistentSRBSmoke\SrbSmokeMath.cs" />
    <Compile Include="PersistentSRBSmoke\SmokeLighting.cs" />
    <Compile Include="PersistentSRBSmoke\VolumetricTrailRules.cs" />
    <Compile Include="PersistentSRBSmoke\VolumetricSmokeTypes.cs" />
    <Compile Include="PersistentSRBSmoke\PadVolumeField.cs" />
    <Compile Include="PersistentSRBSmoke\VolumetricSmokeSystem.cs" />
    <Compile Include="PersistentSRBSmoke\VolumetricSmokeRenderer.cs" />
    <Compile Include="PersistentSRBSmoke\VolumeTrailShadowLayer.cs" />
    <Compile Include="PersistentSRBSmoke\StockSmokeSuppressor.cs" />
    <Compile Include="PersistentSRBSmoke\WindModel.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="CopyToKSP" AfterTargets="Build" Condition=" '$(KSP_DIR)' != '' And '$(UseKspSkeletons)' != 'true' ">
    <MakeDir Directories="$(KSP_DIR)\GameData\PersistentSRBSmoke\Plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KSP_DIR)\GameData\PersistentSRBSmoke\Plugins" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(KSP_DIR)\GameData\PersistentSRBSmoke\Plugins" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
